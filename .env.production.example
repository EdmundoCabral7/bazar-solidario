# Usado SÓ para rodar migrations/seeds contra o banco de produção a partir da sua máquina:
#   npm run prod:migrate | npm run prod:seed | npm run prod:simulation
# Copie para .env.production (ignorado pelo git) e preencha. Nunca commite este arquivo preenchido.
NODE_ENV=production
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require
JWT_SECRET=qualquer-valor-com-pelo-menos-32-caracteres-aqui
WEB_URL=https://SEU-PORTAL.vercel.app
# Senha do admin de demonstração criado pelo seed em produção
SEED_ADMIN_EMAIL=admin@pataspotiguares.org
SEED_ADMIN_PASSWORD=troque-esta-senha
