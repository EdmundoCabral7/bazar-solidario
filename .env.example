# ===== API (apps/api) =====
NODE_ENV=development
PORT=3333
# Banco local (docker compose up)
DATABASE_URL=postgresql://bazar:bazar@localhost:5433/bazar?schema=public
# Banco usado pelos testes de integração
DATABASE_URL_TEST=postgresql://bazar:bazar@localhost:5433/bazar_test?schema=public
# JWT das rotas internas (troque em produção; mínimo 32 caracteres)
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=8h
# Origem permitida no CORS (URL do portal web)
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# mock = sem contas externas | sandbox = credenciais de teste dos provedores
INTEGRATIONS_MODE=mock
# Timeout padrão (ms) para chamadas externas
HTTP_TIMEOUT_MS=5000
# URL pública da API (notification_url do Mercado Pago) e do portal
API_PUBLIC_URL=http://localhost:3333
WEB_URL=http://localhost:3000
# ViaCEP: real (padrão, API pública sem chave) | mock (offline)
VIACEP_MODE=real
# Minutos até cancelar pedido com Pix não pago
ORDER_PAYMENT_TTL_MINUTES=60

# Admin criado pelo seed
SEED_ADMIN_EMAIL=admin@pataspotiguares.org
SEED_ADMIN_PASSWORD=admin123

# Mercado Pago (obrigatório só em INTEGRATIONS_MODE=sandbox; use credenciais TEST-)
MERCADOPAGO_ACCESS_TOKEN=
# Segredo de assinatura do webhook (painel MP > Webhooks). Em mock, qualquer valor.
MERCADOPAGO_WEBHOOK_SECRET=dev-webhook-secret
# Melhor Envio sandbox (sem token, usa a tabela mock mesmo em sandbox)
MELHORENVIO_TOKEN=
MELHORENVIO_FROM_CEP=59000000
MELHORENVIO_USER_AGENT=BazarSolidarioDigital (contato@pataspotiguares.org)
# WhatsApp Cloud API (opcional; sem token as mensagens só são logadas)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ===== WEB (apps/web) =====
NEXT_PUBLIC_API_URL=http://localhost:3333
